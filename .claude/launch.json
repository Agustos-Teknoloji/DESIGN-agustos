{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "agustos-astro",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "adapters/astro",
        "run",
        "dev",
        "--",
        "--port",
        "4321"
      ],
      "port": 4321
