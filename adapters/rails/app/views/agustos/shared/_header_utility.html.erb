<% if agustos_language_switch %>
  <%= link_to agustos_value(agustos_language_switch, :code), agustos_value(agustos_language_switch, :href),
    **agustos_link_html_options(agustos_language_switch, class_name: "agustos-header__lang-link") %>
<% end %>

<% if agustos_theme_config[:theme] %>
  <button type="button" class="agustos-header__icon-btn" aria-label="Toggle light/dark theme" data-action="agustos-theme#toggle">
    <svg class="agustos-header__theme-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4"/></svg>
    <svg class="agustos-header__theme-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
  </button>
<% end %>
