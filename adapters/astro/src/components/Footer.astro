---
import LazGunesi from './LazGunesi.astro';
import type { FooterConfig } from '../types/chrome';

interface Props {
  brandname?: string;
  config?: FooterConfig;
}

const { brandname = 'ağustos', config = {} } = Astro.props;
const year = new Date().getFullYear();
const description = config.description ?? 'Ağustos Design System · multi-brand typography and chrome';
const cta = config.cta === undefined
  ? { href: '/about', label: 'Contact' }
  : config.cta;
const columns = config.columns ?? [
  {
    heading: 'Explore',
    links: [
      { href: '/', label: 'Home' },
      { href: '/about', label: 'About' },
    ],
  },
  {
    heading: 'Content',
    links: [
      { href: '/blog', label: 'Writing' },
      { href: '/typography', label: 'Typography' },
    ],
  },
  {
    heading: 'Repository',
    links: [
      { href: 'https://github.com/Agustos-Teknoloji/DESIGN-agustos', label: 'Source', external: true },
      { href: 'https://github.com/Agustos-Teknoloji/DESIGN-agustos/blob/main/DESIGN.md', label: 'Design spec', external: true },
      { href: 'https://github.com/Agustos-Teknoloji/DESIGN-agustos/blob/main/ASSETS.md', label: 'Asset index', external: true },
    ],
  },
];
---
<footer class="site-footer">
  <div class="site-footer__inner site-frame">
    <div class="site-footer__brand">
      <a class="site-lockup" href="/" aria-label={brandname}>
        <LazGunesi class="site-lockup__symbol" />
        <span class="site-lockup__name">{brandname}</span>
      </a>
      <p class="type-footnote">{description} · &copy; {year}</p>
    </div>

    <div class="site-footer__cols">
      {columns.map((column) => (
        <nav class="site-footer__col" aria-label={column.ariaLabel ?? column.heading}>
          <p class="type-h4 site-footer__col-heading">{column.heading}</p>
          <ul class="site-footer__list">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="site-footer__link"
                  aria-label={link.ariaLabel}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                >{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
      {cta && (
        <a
          href={cta.href}
          class="agustos-button agustos-button--primary site-footer__cta"
          aria-label={cta.ariaLabel}
          target={cta.external ? '_blank' : undefined}
          rel={cta.external ? 'noopener noreferrer' : undefined}
        >{cta.label}</a>
      )}
    </div>
  </div>
</footer>
