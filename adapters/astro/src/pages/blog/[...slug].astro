---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = new Intl.DateTimeFormat(post.data.lang === 'tr' ? 'tr-TR' : 'en-GB', {
  day: 'numeric', month: 'long', year: 'numeric',
});
---
<BaseLayout
  screen="content"
  title={`${post.data.title} — Ağustos Teknoloji`}
  description={post.data.deck}
  brand={post.data.brand}
  lang={post.data.lang}
  searchKind="post"
>
  <article class="container" lang={post.data.lang}>
    <header class="post-header">
      <p class="type-h4">{fmt.format(post.data.date)}</p>
      <h1 class="type-h1">{post.data.title}</h1>
      {post.data.deck && <p class="type-body post-deck"><em>{post.data.deck}</em></p>}
    </header>

    <hr class="type-divider" />

    <div class="post-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  /* Post header — date → H1 → deck. Same baseline rhythm as the article body. */
  .post-header { margin-bottom: 2.5rem; }
  .post-deck { font-size: 18px; color: var(--ink-soft); margin-top: 1.4em; }

  /* Markdown-rendered content needs no rules here: tokens.css styles bare
     h1–h4 and p the same as their .type-* classes. */
</style>
