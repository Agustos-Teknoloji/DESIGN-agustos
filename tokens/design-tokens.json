{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Ağustos Design System",
  "version": "5.0.0",
  "description": "Canonical cross-medium design values. CSS, framework adapters, and Office templates are generated consumers.",
  "meta": {
    "referenceImplementation": "https://agustos.com",
    "authority": "DESIGN-agustos",
    "principle": "The website proves the grammar; this registry publishes it.",
    "locale": "tr"
  },
  "designDirection": {
    "name": "İskandivvian",
    "definition": "Scandinavian restraint filtered through Mediterranean warmth.",
    "naming": "Use this as a defined project label, not an established design movement.",
    "intent": "Create minimal, functional, and elegant experiences that feel calm, warm, and human.",
    "keywords": [
      "calm",
      "clear",
      "warm",
      "functional",
      "elegant",
      "approachable",
      "grounded",
      "quietly confident"
    ],
    "principles": [
      "White is the primary substrate (~70% of every surface); cream is a full-bleed callout/CTA-band tint only, never the page paper.",
      "Make every section useful. Keep navigation, information, and next actions easy to understand.",
      "Use clear hierarchy and one alignment frame. Let spacing explain relationships without hiding useful content.",
      "Use modest corners and selective borders. Flat surfaces — no shadows anywhere.",
      "Use authentic imagery only when it explains people, places, products, or work. Preserve product colors and technical facts.",
      "Keep text, controls, and technical tables on plain surfaces. Flat pages without imagery are a complete expression.",
      "Retain registered logos, font families, red interaction signals, supported themes, and accessible contrast.",
      "Write direct, helpful copy with familiar words. Explain practical benefits and next steps. Sentence case everywhere — no uppercase labels, eyebrows, or headers."
    ],
    "avoid": [
      "Ornamental Mediterranean motifs or unrelated lifestyle imagery",
      "Replacing red interaction signals with earthy accent colors",
      "Low-contrast text, vague labels, excessive whitespace, or decorative motion",
      "Inflated luxury claims, forced friendliness, uppercase text, or any shadow",
      "Cream used as a page substrate, an inset rounded card, or mixed with a gray band on the same page"
    ],
    "acceptance": [
      "Pages feel warm, human, and complete through clear typography, purposeful spacing, and helpful language.",
      "Visitors can understand the content and identify the next action quickly.",
      "Forms and technical content remain clear, readable, and easy to scan.",
      "Brand identity, keyboard focus, reduced motion, and supported themes remain intact."
    ]
  },
  "distribution": {
    "repository": "Agustos-Teknoloji/DESIGN-agustos",
    "cdnBase": "https://cdn.jsdelivr.net/gh/{repository}@v{version}/ui/",
    "rawBase": "https://raw.githubusercontent.com/{repository}/v{version}/ui/",
    "fonts": [
      {
        "file": "inter-tight-variable.woff2",
        "families": ["Inter Tight Variable", "Inter Tight"],
        "style": "normal",
        "weight": "100 900"
      },
      {
        "file": "inter-tight-variable-italic.woff2",
        "families": ["Inter Tight Variable", "Inter Tight"],
        "style": "italic",
        "weight": "100 900"
      },
      {
        "file": "inter-variable.woff2",
        "families": ["Inter Variable", "Inter"],
        "style": "normal",
        "weight": "100 900"
      },
      {
        "file": "inter-variable-italic.woff2",
        "families": ["Inter Variable", "Inter"],
        "style": "italic",
        "weight": "100 900"
      },
      {
        "file": "jetbrains-mono-variable.woff2",
        "families": ["JetBrains Mono Variable", "JetBrains Mono"],
        "style": "normal",
        "weight": "100 800"
      }
    ]
  },
  "foundations": {
    "color": {
      "$type": "color",
      "paperCream": { "$value": "#fdf5f5", "$description": "Callout/CTA band tint only — logo red at 5% into white. Never a page substrate; always a full-bleed band with hairline rules top and bottom." },
      "paperWhite": { "$value": "#ffffff", "$description": "Primary substrate, ~70% of every surface." },
      "surfaceMuted": { "$value": "#f4f2ed", "$description": "Functional surfaces: key-figure tiles, image regions, summary panels." },
      "ink": { "$value": "#15130f", "$description": "Off-black. Headlines, filled buttons, footer, and shared non-Ağustos brand identity ink." },
      "inkSoft": { "$value": "#403b34", "$description": "Dark gray. Secondary text." },
      "inkFaint": { "$value": "#8a8378", "$description": "Faint label text — captions, metadata, quiet proof." },
      "ruleCream": { "$value": "#e8e4da", "$description": "Hairline rule." },
      "ruleWhite": { "$value": "#e8e4da", "$description": "Hairline rule." },
      "paperDark": { "$value": "#16140f", "$description": "Warm dark UI substrate." },
      "inkDark": { "$value": "#f0ebd8", "$description": "Primary text on dark." },
      "inkSoftDark": { "$value": "#a8a39a", "$description": "Secondary text on dark." },
      "inkFaintDark": { "$value": "#6e6960", "$description": "Quiet text on dark." },
      "ruleDark": { "$value": "#2a2620", "$description": "Separator on dark." },
      "signalRed": { "$value": "#cf142a", "$description": "Shared Ağustos-family interaction signal for links, focus, markers, and small emphasis across every brand." },
      "stateSuccess": { "$value": "#1f6b4a", "$description": "Positive system feedback." },
      "stateWarning": { "$value": "#8a5a00", "$description": "Caution system feedback." },
      "stateDanger": { "$value": "#b42318", "$description": "Destructive or failed system feedback." },
      "stateInfo": { "$value": "#1a4d8f", "$description": "Informational system feedback." },
      "stateSuccessDark": { "$value": "#7ec9a2", "$description": "Positive system feedback on the dark substrate." },
      "stateWarningDark": { "$value": "#d9a441", "$description": "Caution system feedback on the dark substrate." },
      "stateDangerDark": { "$value": "#f08c82", "$description": "Destructive or failed system feedback on the dark substrate." },
      "stateInfoDark": { "$value": "#8ab6e8", "$description": "Informational system feedback on the dark substrate." }
    },
    "fontFamily": {
      "$type": "fontFamily",
      "display": { "$value": "Inter Tight", "$description": "Wordmarks, heroes, headings, labels, and designed UI." },
      "body": { "$value": "Inter", "$description": "Reading text and inline content." },
      "mono": { "$value": "JetBrains Mono", "$description": "Code, identifiers, units, and technical values." }
    },
    "fontWeight": {
      "$type": "fontWeight",
      "light": { "$value": 300 },
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "wordmark": { "$value": 650 },
      "bold": { "$value": 700 }
    },
    "fontSize": {
      "$type": "dimension",
      "hero": { "$value": "clamp(56px, 9vw, 112px)" },
      "heroMedium": { "$value": "clamp(40px, 6vw, 72px)" },
      "heroDeck": { "$value": "clamp(18px, 1.5vw, 21px)" },
      "h1": { "$value": "44px" },
      "h2": { "$value": "24px" },
      "h3": { "$value": "18px" },
      "h4": { "$value": "13px" },
      "body": { "$value": "16.5px" },
      "bodyCompact": { "$value": "14px" },
      "footnote": { "$value": "12.5px" }
    },
    "spacing": {
      "$type": "dimension",
      "2xs": { "$value": "4px" },
      "xs": { "$value": "8px" },
      "sm": { "$value": "12px" },
      "md": { "$value": "16px" },
      "lg": { "$value": "20px" },
      "xl": { "$value": "24px" },
      "2xl": { "$value": "32px" },
      "3xl": { "$value": "40px" },
      "4xl": { "$value": "48px" },
      "5xl": { "$value": "64px" },
      "6xl": { "$value": "80px" },
      "hero": { "$value": "112px" }
    },
    "radius": {
      "$type": "dimension",
      "small": { "$value": "4px" },
      "medium": { "$value": "6px" },
      "large": { "$value": "10px" }
    },
    "duration": {
      "$type": "duration",
      "micro": { "$value": "150ms" },
      "short": { "$value": "180ms" },
      "drawer": { "$value": "220ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "move": { "$value": [0.4, 0, 0.2, 1] }
    },
    "measure": {
      "$type": "dimension",
      "content": { "$value": "1180px", "$description": "Shared content measure for page and chrome." },
      "gutter": { "$value": "32px", "$description": "Horizontal frame gutter." },
      "text": { "$value": "72ch", "$description": "Readable long-form body measure." },
      "heroText": { "$value": "54ch", "$description": "Hero supporting-copy measure." },
      "wide": { "$value": "1200px", "$description": "Optional media and data width." },
      "controlMinimum": { "$value": "44px", "$description": "Minimum button-like target on the shorter axis." }
    },
    "border": {
      "$type": "dimension",
      "hairline": { "$value": "1px" },
      "signal": { "$value": "2px" }
    }
  },
  "semantic": {
    "color": {
      "$type": "color",
      "paper": { "$value": "{foundations.color.paperWhite}" },
      "surface": { "$value": "{foundations.color.paperWhite}" },
      "surfaceMuted": { "$value": "{foundations.color.surfaceMuted}" },
      "text": { "$value": "{foundations.color.ink}" },
      "textMuted": { "$value": "{foundations.color.inkSoft}" },
      "textFaint": { "$value": "{foundations.color.inkFaint}" },
      "rule": { "$value": "{foundations.color.ruleWhite}" },
      "brandMark": { "$value": "{brand.color}" },
      "signal": { "$value": "{foundations.color.signalRed}" },
      "focus": { "$value": "{semantic.color.signal}" }
    },
    "typography": {
      "display": { "$value": "{foundations.fontFamily.display}" },
      "body": { "$value": "{foundations.fontFamily.body}" },
      "data": { "$value": "{foundations.fontFamily.mono}" },
      "wordmarkWeight": { "$value": "{foundations.fontWeight.wordmark}" }
    },
    "layout": {
      "contentMeasure": { "$value": "{foundations.measure.content}" },
      "contentGutter": { "$value": "{foundations.measure.gutter}" },
      "readingMeasure": { "$value": "{foundations.measure.text}" }
    },
    "shape": {
      "controlRadius": { "$value": "{foundations.radius.medium}" },
      "buttonRadius": { "$value": "{foundations.radius.medium}" },
      "cardRadius": { "$value": "{foundations.radius.large}" }
    },
    "motion": {
      "interactionDuration": { "$value": "{foundations.duration.micro}" },
      "interactionEasing": { "$value": "{foundations.easing.standard}" }
    }
  },
  "themes": {
    "white": {
      "paper": { "$value": "{foundations.color.paperWhite}" },
      "surface": { "$value": "{foundations.color.paperWhite}" },
      "rule": { "$value": "{foundations.color.ruleWhite}" },
      "$description": "No-op as of v5.0.0 — white is now the default paper. Kept for back-compat with any consumer still applying `.paper-white` explicitly."
    },
    "creamBand": {
      "paper": { "$value": "{foundations.color.paperCream}" },
      "surface": { "$value": "{foundations.color.paperWhite}" },
      "rule": { "$value": "{foundations.color.ruleWhite}" },
      "$description": "Opt-in, full-bleed callout/CTA band only — never an inset card, never the page substrate."
    },
    "dark": {
      "paper": { "$value": "{foundations.color.paperDark}" },
      "surface": { "$value": "{foundations.color.paperDark}" },
      "text": { "$value": "{foundations.color.inkDark}" },
      "textMuted": { "$value": "{foundations.color.inkSoftDark}" },
      "textFaint": { "$value": "{foundations.color.inkFaintDark}" },
      "rule": { "$value": "{foundations.color.ruleDark}" }
    }
  },
  "recipes": {
    "chrome": {
      "contentMeasure": { "$value": "{semantic.layout.contentMeasure}" },
      "gutter": { "$value": "{semantic.layout.contentGutter}" },
      "controlMinimum": { "$value": "{foundations.measure.controlMinimum}" },
      "paddingBlock": { "$value": "14px" },
      "gap": { "$value": "{foundations.spacing.2xl}" },
      "rule": { "$value": "{foundations.border.hairline}" }
    },
    "hero": {
      "paddingBlockStart": { "$value": "clamp(56px, 9vw, 112px)" },
      "paddingBlockEnd": { "$value": "clamp(48px, 6vw, 80px)" },
      "headline": { "$value": "heroMedium" },
      "deckMeasure": { "$value": "{foundations.measure.heroText}" },
      "actionGap": { "$value": "{foundations.spacing.xl}" }
    },
    "section": {
      "paddingBlock": { "$value": "clamp(48px, 6vw, 80px)" },
      "headingGap": { "$value": "{foundations.spacing.sm}" },
      "rule": { "$value": "{foundations.border.hairline}" }
    },
    "card": {
      "surface": { "$value": "{semantic.color.surface}" },
      "padding": { "$value": "{foundations.spacing.xl}" },
      "gap": { "$value": "14px" },
      "gridGap": { "$value": "{foundations.spacing.lg}" },
      "radius": { "$value": "{semantic.shape.cardRadius}" },
      "border": { "$value": "{foundations.border.hairline}" },
      "markedBorder": { "$value": "{foundations.border.signal}" }
    },
    "dataTable": {
      "labelFamily": { "$value": "{semantic.typography.display}" },
      "valueFamily": { "$value": "{semantic.typography.data}" },
      "cellPaddingBlock": { "$value": "{foundations.spacing.xs}" },
      "cellPaddingInline": { "$value": "{foundations.spacing.sm}" },
      "rule": { "$value": "{foundations.border.hairline}" }
    },
    "document": {
      "page": { "$value": "A4" },
      "margin": { "$value": "22mm" },
      "topMargin": { "$value": "35mm" },
      "bodySize": { "$value": "11pt" },
      "titleSize": { "$value": "28pt" },
      "heading1Size": { "$value": "20pt" },
      "heading2Size": { "$value": "15pt" },
      "heading3Size": { "$value": "12pt" },
      "footnoteSize": { "$value": "8.5pt" },
      "bodyAfter": { "$value": "8pt" },
      "bodyLineSpacing": { "$value": 1.35 }
    },
    "presentation": {
      "width": { "$value": "13.333in" },
      "height": { "$value": "7.5in" },
      "margin": { "$value": "0.9in" },
      "titleSize": { "$value": "54pt" },
      "sectionTitleSize": { "$value": "44pt" },
      "slideTitleSize": { "$value": "36pt" },
      "bodySize": { "$value": "20pt" },
      "captionSize": { "$value": "12pt" }
    }
  },
  "compatibility": {
    "cssClasses": [
        "type-hero",
        "type-hero-md",
        "type-hero-deck",
        "type-h1",
        "type-h2",
        "type-h3",
        "type-h4",
        "type-body",
        "type-link",
        "type-code",
        "type-blockquote",
        "type-pullquote",
        "type-list-ol",
        "type-list-ul",
        "type-dl",
        "type-figure",
        "type-code-block",
        "type-table",
        "type-divider",
        "type-footnote",
        "site-frame",
        "container",
        "skip-link",
        "brand-agustos",
        "brand-pataraz",
        "brand-pld",
        "brand-iesdesk",
        "brand-specquick",
        "paper-white",
        "band-cream",
        "hero-links",
        "hero-link",
        "hero-link--primary",
        "hero-link--secondary",
        "hero-actions",
        "hero-action",
        "hero-action--primary",
        "hero-action--secondary",
        "hero-trust",
        "hero-visual",
        "agustos-section",
        "agustos-section__head",
        "agustos-card-grid",
        "agustos-card",
        "agustos-card--marked",
        "agustos-chrome-link",
        "agustos-fieldset",
        "agustos-field",
        "agustos-field--invalid",
        "agustos-label",
        "agustos-label--required",
        "agustos-input",
        "agustos-textarea",
        "agustos-select",
        "agustos-check",
        "agustos-hint",
        "agustos-error",
        "agustos-button",
        "agustos-button--primary",
        "agustos-button--secondary",
        "agustos-badge",
        "agustos-badge--success",
        "agustos-badge--warning",
        "agustos-badge--danger",
        "agustos-badge--info",
        "agustos-badge--signal",
        "agustos-notice",
        "agustos-notice__title",
        "agustos-notice--success",
        "agustos-notice--warning",
        "agustos-notice--danger",
        "agustos-notice--info",
        "agustos-tabs",
        "agustos-tab",
        "agustos-tabs__panel"
      ]
  }
}
