<% responsive = variant == :responsive %>
<% suffix = "#{variant}-#{agustos_theme_config[:lang]}" %>
<% frame_id = "agustos-header-search-results-#{suffix}" %>
<% panel_id = "agustos-header-search-panel-#{suffix}" %>
<% labels = agustos_search_labels %>
<% search_param = agustos_value(agustos_search_config, :param, :q) %>

<% search_form = capture do %>
  <%= form_with url: agustos_value(agustos_search_config, :url), method: :get, data: { turbo_frame: frame_id, agustos_search_target: "form" } do |form| %>
    <%= form.hidden_field :frame_id, value: frame_id %>
    <label class="agustos-header__search-field">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <%= form.search_field search_param, placeholder: labels[:placeholder], aria: { label: labels[:aria], controls: panel_id, expanded: "false" }, autocomplete: "off", data: { agustos_search_target: "input", action: "input->agustos-search#queue focus->agustos-search#focus" } %>
    </label>
  <% end %>
<% end %>

<% search_root = capture do %>
  <div
    class="agustos-header__search agustos-header__search--<%= responsive ? 'responsive' : 'desktop' %>"
    data-controller="agustos-search"
    data-action="keydown->agustos-search#navigate click@window->agustos-search#outside"
    data-agustos-search-threshold-value="2"
    data-agustos-search-delay-value="180"
  >
    <% if responsive %>
      <%= search_form %>
      <div id="<%= panel_id %>" class="agustos-header__search-panel" data-agustos-search-target="panel" hidden>
        <%= turbo_frame_tag frame_id, class: "agustos-header__search-output", aria: { live: "polite" } %>
      </div>
    <% else %>
      <button type="button" class="agustos-header__search-toggle" aria-label="<%= labels[:aria] %>" aria-expanded="false" aria-controls="<%= panel_id %>" data-agustos-search-target="toggle" data-action="agustos-search#toggle">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </button>
      <div id="<%= panel_id %>" class="agustos-header__search-panel" data-agustos-search-target="panel" hidden>
        <%= search_form %>
        <%= turbo_frame_tag frame_id, class: "agustos-header__search-output", aria: { live: "polite" } %>
      </div>
    <% end %>
  </div>
<% end %>

<% if responsive %>
  <div class="agustos-header__search-row"><div class="agustos-header__search-shell site-frame"><%= search_root %></div></div>
<% else %>
  <%= search_root %>
<% end %>
