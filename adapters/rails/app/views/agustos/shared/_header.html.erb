<% menu_items, more_items = agustos_nav_split %>
<header class="site-header">
  <div class="site-header__bar site-frame">
    <%= render "agustos/shared/brand_lockup", href: agustos_theme_config[:home_href] %>

    <div id="site-header-panel" class="site-header__panel" popover>
      <div class="site-header__panel-brand">
        <%= render "agustos/shared/brand_lockup", href: agustos_theme_config[:home_href] %>
      </div>
      <button type="button" class="site-header__close" popovertarget="site-header-panel" popovertargetaction="hide" aria-label="<%= agustos_chrome_labels[:close_menu] %>">
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="1.5"/></svg>
    </button>
      <nav class="site-header__nav" aria-label="<%= agustos_chrome_labels[:nav] %>">
        <% menu_items.each do |item| %>
          <%= link_to agustos_value(item, :label), agustos_value(item, :href), **agustos_nav_link_options(item, class_name: "site-header__link") %>
        <% end %>
        <% if more_items.any? %>
          <details class="site-header__more">
            <summary class="site-header__link"><%= agustos_more_label %></summary>
            <div class="site-header__more-menu">
              <% more_items.each do |item| %>
                <%= link_to agustos_value(item, :label), agustos_value(item, :href), **agustos_nav_link_options(item, class_name: "site-header__more-link") %>
              <% end %>
            </div>
          </details>
        <% end %>
      </nav>

      <div class="site-header__end">
        <% if agustos_search_config %>
          <%= render "agustos/shared/header_search", variant: :desktop %>
        <% end %>

        <% if agustos_header_utility? %>
          <div class="site-header__utility site-header__utility--drawer">
            <%= render "agustos/shared/header_utility" %>
          </div>
        <% end %>

        <% if agustos_header_cta %>
          <%= link_to agustos_value(agustos_header_cta, :label), agustos_value(agustos_header_cta, :href),
            **agustos_link_html_options(agustos_header_cta, class_name: "agustos-button agustos-button--primary site-header__cta") %>
        <% end %>
      </div>
    </div>

    <% if agustos_header_utility? %>
      <div class="site-header__utility site-header__utility--bar">
        <%= render "agustos/shared/header_utility" %>
      </div>
    <% end %>
    <button type="button" class="site-header__burger" popovertarget="site-header-panel" aria-label="<%= agustos_chrome_labels[:open_menu] %>">
      <svg width="18" height="14" viewBox="0 0 18 14" aria-hidden="true" focusable="false"><path d="M0 1h18M0 7h18M0 13h18" stroke="currentColor" stroke-width="1.5"/></svg>
    </button>
  </div>

  <% if agustos_search_config %>
    <%= render "agustos/shared/header_search", variant: :responsive %>
    <noscript>
      <div class="site-header__noscript-search site-frame">
        <%= form_with url: agustos_value(agustos_search_config, :url), method: :get, local: true do |form| %>
          <%= form.search_field agustos_value(agustos_search_config, :param, :q), class: "agustos-input", placeholder: agustos_search_labels[:placeholder], aria: { label: agustos_search_labels[:aria] } %>
          <%= form.submit agustos_search_labels[:submit], class: "agustos-button agustos-button--primary" %>
        <% end %>
      </div>
    </noscript>
  <% end %>
</header>
