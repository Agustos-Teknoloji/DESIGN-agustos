---
import BrandLockup from './BrandLockup.astro';

/**
 * Top bar visible only on tablet/mobile (<1024px). Lockup on the left,
 * hamburger button on the right. Tapping the hamburger toggles the
 * Sidebar drawer via body[data-nav-open].
 *
 * On desktop this entire component is hidden — the sidebar is always visible.
 */

interface Props {
  brandname: string;
}
const { brandname } = Astro.props;
---
<header class="mobile-header">
  <div class="mobile-header__inner">
    <BrandLockup brandname={brandname} href="/" size={18} />
    <button
      type="button"
      class="mobile-header__burger"
      aria-label="Open navigation"
      aria-controls="site-sidebar"
      aria-expanded="false"
      data-nav-toggle
    >
      <span class="mobile-header__burger-bar"></span>
      <span class="mobile-header__burger-bar"></span>
      <span class="mobile-header__burger-bar"></span>
    </button>
  </div>
</header>

{/* Backdrop — covers content when drawer is open. Click to close. */}
<button
  type="button"
  class="nav-backdrop"
  aria-label="Close navigation"
  data-nav-close
></button>

<style>
  .mobile-header {
    display: none;
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
    padding: 0.75rem 1rem;
  }

  .mobile-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .mobile-header__burger {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
    width: 40px;
    height: 40px;
    padding: 0;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    cursor: pointer;
    transition: background 120ms ease, border-color 120ms ease;
  }
  .mobile-header__burger:hover { background: var(--rule); }
  .mobile-header__burger:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  .mobile-header__burger-bar {
    display: block;
    width: 18px;
    height: 1.5px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform 200ms ease, opacity 200ms ease;
  }

  /* X transformation when nav is open. */
  :global(body[data-nav-open="true"]) .mobile-header__burger-bar:nth-child(1) {
    transform: translateY(5.5px) rotate(45deg);
  }
  :global(body[data-nav-open="true"]) .mobile-header__burger-bar:nth-child(2) {
    opacity: 0;
  }
  :global(body[data-nav-open="true"]) .mobile-header__burger-bar:nth-child(3) {
    transform: translateY(-5.5px) rotate(-45deg);
  }

  .nav-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 45;
    background: rgba(26, 26, 26, 0.32);
    border: 0;
    padding: 0;
    cursor: pointer;
    opacity: 0;
    transition: opacity 200ms ease;
  }

  /* Show on tablet/mobile only. */
  @media (max-width: 1023px) {
    .mobile-header { display: block; }

    :global(body[data-nav-open="true"]) .nav-backdrop {
      display: block;
      opacity: 1;
    }
  }
</style>

<script>
  // Toggle the drawer via body[data-nav-open]. Sidebar.astro reads that
  // attribute to translate itself in/out from the right.
  const body = document.body;

  function setOpen(open: boolean) {
    if (open) body.setAttribute('data-nav-open', 'true');
    else body.removeAttribute('data-nav-open');
    document.querySelectorAll<HTMLButtonElement>('[data-nav-toggle]').forEach((btn) => {
      btn.setAttribute('aria-expanded', String(open));
    });
    // Lock body scroll when drawer is open on mobile.
    body.style.overflow = open ? 'hidden' : '';
  }

  document.querySelectorAll<HTMLButtonElement>('[data-nav-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      setOpen(body.getAttribute('data-nav-open') !== 'true');
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-nav-close]').forEach((btn) => {
    btn.addEventListener('click', () => setOpen(false));
  });

  // Close on ESC.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && body.getAttribute('data-nav-open') === 'true') {
      setOpen(false);
    }
  });

  // Close after navigation (tapping a link inside the drawer).
  document.querySelectorAll<HTMLAnchorElement>('.sidebar a').forEach((a) => {
    a.addEventListener('click', () => {
      if (window.matchMedia('(max-width: 1023px)').matches) setOpen(false);
    });
  });
</script>
