---
import BrandLockup from './BrandLockup.astro';

/**
 * Persistent left sidebar (≥1024px) — and the same component renders as the
 * right-slide drawer on tablet/mobile. The visual pattern matches agustos.com:
 *
 *   ┌──────────────────────┐
 *   │  ☼ ağustos           │  ← BrandLockup (symbol + wordmark in IBM Plex Light)
 *   │                      │
 *   │  🌐 EN  ☀️           │  ← language selector + theme toggle (functional)
 *   │  🔍 Search           │
 *   │                      │
 *   │  ⌂ Home          •   │  ← active items get a brand-tinted background.
 *   │  ⓘ About             │     The active-state IS a navigational signal,
 *   │  📖 Writing          │     so this honors Rule 5 (brand color = links).
 *   │  Aa Typography       │
 *   └──────────────────────┘
 *
 * Active link detection: pass Astro.url.pathname from the layout. The component
 * highlights items whose href matches the current path (with prefix-matching for
 * sub-paths like /blog/some-post).
 */

interface NavItem {
  href: string;
  label: string;
  /** Lucide-style icon name. Add new icons to the ICONS map below. */
  icon: 'home' | 'info' | 'book' | 'type' | 'mail' | 'rss';
}

interface Props {
  brandname: string;
  pathname: string;
}

const { brandname, pathname } = Astro.props;

const items: NavItem[] = [
  { href: '/',           label: 'Home',       icon: 'home' },
  { href: '/about',      label: 'About',      icon: 'info' },
  { href: '/blog',       label: 'Writing',    icon: 'book' },
  { href: '/typography', label: 'Typography', icon: 'type' },
];

// Lucide-style stroke icons. 24×24 viewBox, currentColor stroke.
// To add an icon: pick from https://lucide.dev and inline its <path>.
const ICONS: Record<NavItem['icon'], string> = {
  home: '<path d="M3 9.5 12 3l9 6.5V20a1 1 0 0 1-1 1h-5v-7h-6v7H4a1 1 0 0 1-1-1V9.5z"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v4h1"/>',
  book: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5v14z"/><path d="M4 19.5V21h15"/>',
  type: '<path d="M4 7V5h16v2"/><path d="M9 20h6"/><path d="M12 5v15"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  rss:  '<path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/>',
};

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href + '/');
}
---
<aside class="sidebar" aria-label="Primary">
  {/* Top: full BrandLockup — symbol + wordmark in IBM Plex Sans Light. */}
  <div class="sidebar__mark">
    <BrandLockup brandname={brandname} href="/" size={24} />
  </div>

  {/* Top action row — language selector + theme toggle. Minimalist: two letters
      side by side for language, single icon button for theme. No chrome. */}
  <div class="sidebar__actions">
    <div class="sidebar__lang" role="group" aria-label="Language">
      <button type="button" data-lang="en" aria-label="English">EN</button>
      <span class="sidebar__lang-sep" aria-hidden="true">·</span>
      <button type="button" data-lang="tr" aria-label="Türkçe">TR</button>
    </div>

    {/* Theme toggle. Click flips data-theme on <html> and persists to localStorage.
        Initial state is set by an inline script in BaseLayout (avoids FOUC). */}
    <button type="button" class="sidebar__icon-btn" aria-label="Toggle light/dark theme" data-theme-toggle>
      <svg class="sidebar__theme-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"/>
        <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4"/>
      </svg>
      <svg class="sidebar__theme-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
      </svg>
    </button>
  </div>

  {/* Search — visual stub. Wire up to pagefind, fuse.js, or similar when ready. */}
  <label class="sidebar__search">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7"/>
      <path d="m20 20-3.5-3.5"/>
    </svg>
    <input type="search" placeholder="Search" aria-label="Search this site" />
  </label>

  {/* Primary nav */}
  <nav class="sidebar__nav" aria-label="Site sections">
    <ul>
      {items.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={['sidebar__link', { 'sidebar__link--active': isActive(item.href) }]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[item.icon]} />
            <span>{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</aside>

<style>
  .sidebar {
    /* Layout */
    width: 280px;
    height: 100dvh;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.5rem 1rem 1.5rem 1.5rem;
    overflow-y: auto;

    /* Skin */
    background: var(--paper);
    border-right: 1px solid var(--rule);
  }

  .sidebar__mark {
    /* Wrapper that doubles as the lockup tile in dark mode. Padding is applied
       in BOTH themes so the bounding box stays the same when toggling — only
       the background swaps. Otherwise the lockup appears to "jump" size. */
    width: max-content;
    padding: 0.5rem 0.75rem;
    margin: -0.5rem 0 -0.25rem -0.75rem;   /* visually align the lockup contents
                                              with the rest of the sidebar's
                                              left edge despite the padding */
    border-radius: 8px;
    transition: background 160ms ease;
  }

  /* Dark theme: switch the lockup to its negative expression — cream on a
     brand-color tile (DESIGN.md §"Three expressions"). The --lockup-color
     custom property is read by BrandLockup as the color of symbol + wordmark.
     No padding change here — only the background appears. */
  :global(html[data-theme="dark"]) .sidebar__mark {
    --lockup-color: var(--ink);   /* in dark theme --ink resolves to #f0ebd8 (cream) */
    background: var(--brand);
  }

  .sidebar__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* ---- Language selector — bare-bones EN · TR pair ---- */

  .sidebar__lang {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    margin-right: auto;     /* push the theme toggle to the right */
    font-family: var(--display);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .sidebar__lang button {
    background: transparent;
    border: 0;
    padding: 0;
    color: var(--ink-faint);
    cursor: pointer;
    font: inherit;
    letter-spacing: inherit;
    transition: color 120ms ease;
  }
  .sidebar__lang button:hover { color: var(--ink-soft); }
  .sidebar__lang button[aria-current="true"] {
    color: var(--ink);
  }
  .sidebar__lang button:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 3px;
    border-radius: 2px;
  }
  .sidebar__lang-sep {
    color: var(--ink-faint);
    user-select: none;
  }

  /* ---- Theme toggle ---- */

  .sidebar__icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: var(--ink-soft);
    cursor: pointer;
    transition: background 120ms ease, color 120ms ease;
  }
  .sidebar__icon-btn:hover { background: var(--rule); color: var(--ink); }
  .sidebar__icon-btn:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }
  /* Show sun in light theme, moon in dark theme. */
  .sidebar__theme-moon { display: none; }
  :global(html[data-theme="dark"]) .sidebar__theme-sun  { display: none; }
  :global(html[data-theme="dark"]) .sidebar__theme-moon { display: inline-block; }

  /* ---- Search ---- */

  .sidebar__search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.75rem;
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 8px;
    color: var(--ink-faint);
    transition: border-color 120ms ease;
  }
  .sidebar__search:focus-within { border-color: var(--ink-faint); color: var(--ink); }
  .sidebar__search input {
    flex: 1;
    border: 0;
    background: transparent;
    outline: 0;
    color: inherit;
    font-family: var(--display);
    font-size: 14px;
    padding: 0;
  }
  .sidebar__search input::placeholder { color: var(--ink-faint); }

  /* ---- Nav ---- */

  .sidebar__nav { margin-top: 0.25rem; }
  .sidebar__nav ul { list-style: none; padding: 0; margin: 0; }
  .sidebar__nav li { margin: 2px 0; }

  .sidebar__link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.75rem;
    border-radius: 8px;
    color: var(--ink-soft);
    /* Sidebar links are navigation, not prose. The system's bold+brand-underline
       treatment is for content links; nav uses a presence + tinted-bg pattern. */
    text-decoration: none;
    font-family: var(--display);
    font-size: 17px;       /* primary nav weight — sits above body register (16.5px) */
    font-weight: 500;
    line-height: 1.25;
    transition: background 120ms ease, color 120ms ease;
  }
  .sidebar__link:hover { color: var(--ink); background: var(--rule); }

  /* Active state — brand-tinted background. The active item IS a navigational
     signal (which page you're on), so the brand-color use here is consistent
     with Rule 5 ("brand color = links"). */
  .sidebar__link--active {
    background: color-mix(in srgb, var(--brand) 12%, transparent);
    color: var(--ink);
  }
  .sidebar__link--active:hover {
    background: color-mix(in srgb, var(--brand) 16%, transparent);
  }

  /* ------------------------------------------------------------------
     Responsive: <1024px — sidebar becomes a right-slide drawer.
     Hidden by default; opens when body[data-nav-open="true"].
     ------------------------------------------------------------------ */
  @media (max-width: 1023px) {
    .sidebar {
      left: auto;
      right: 0;
      width: min(320px, 86vw);
      border-right: 0;
      border-left: 1px solid var(--rule);
      transform: translateX(100%);
      transition: transform 220ms cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: -8px 0 32px rgba(26, 26, 26, 0.06);
    }
    :global(body[data-nav-open="true"]) .sidebar {
      transform: translateX(0);
    }
  }
</style>

<script>
  // ---- Theme toggle: persists to localStorage; reflects on html[data-theme]. ----
  const THEME_KEY = 'agustos:theme';
  const html = document.documentElement;

  function applyTheme(theme: 'light' | 'dark') {
    if (theme === 'dark') html.setAttribute('data-theme', 'dark');
    else html.removeAttribute('data-theme');
    try { localStorage.setItem(THEME_KEY, theme); } catch { /* private mode */ }
  }

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      applyTheme(next);
    });
  });

  // ---- Language selector: persists choice; updates <html lang> + UI label. ----
  // NOTE: this writes the preference but does not yet route to translated pages.
  // Wire to Astro's i18n (astro.config.mjs `i18n: { locales: ['en', 'tr'], … }`)
  // and per-locale page variants when ready.
  const LANG_KEY = 'agustos:lang';

  function applyLang(lang: 'en' | 'tr') {
    html.setAttribute('lang', lang);
    document.querySelectorAll<HTMLButtonElement>('[data-lang]').forEach((btn) => {
      if (btn.dataset.lang === lang) btn.setAttribute('aria-current', 'true');
      else btn.removeAttribute('aria-current');
    });
    try { localStorage.setItem(LANG_KEY, lang); } catch { /* private mode */ }
  }

  // Initialise from storage (or default to current <html lang>).
  try {
    const saved = localStorage.getItem(LANG_KEY) as 'en' | 'tr' | null;
    if (saved === 'en' || saved === 'tr') applyLang(saved);
    else applyLang((html.getAttribute('lang') as 'en' | 'tr') || 'en');
  } catch {
    applyLang((html.getAttribute('lang') as 'en' | 'tr') || 'en');
  }

  document.querySelectorAll<HTMLButtonElement>('[data-lang]').forEach((btn) => {
    btn.addEventListener('click', () => {
      applyLang(btn.dataset.lang as 'en' | 'tr');
    });
  });
</script>
