<!doctype html>
<html lang="<%= agustos_theme_config[:lang] %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%# theme: true adds the theme switch. This script applies a stored dark choice before the first paint. %>
    <%= javascript_tag AgustosThemeHelper::THEME_SCRIPT, nonce: true if agustos_theme_toggle? %>
    <meta name="description" content="<%= agustos_meta_description %>">
    <title><%= agustos_page_title %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# Load ui/agustos-fonts.css (or @fontsource) before tokens. Font stacks alone are not faces. %>
    <%= stylesheet_link_tag "agustos/tokens", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "agustos/components", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>
  <%# data-screen comes first: the kit checker reads the body tag only up to its first closing bracket. %>
  <body
    data-screen="<%= agustos_screen %>"
    class="<%= agustos_body_class %>"
    data-controller="<%= agustos_body_controller %>"
  >
    <a class="skip-link" href="#main"><%= agustos_chrome_labels[:skip] %></a>
    <% if agustos_product_shell? %>
      <%# Product UI: the sidebar. Chrome follows the screen family, not the brand. %>
      <%= render "agustos/shared/sidebar" %>
      <main id="main" tabindex="-1">
        <%= yield %>
      </main>
    <% else %>
      <%# Websites: the top menu and the footer. %>
      <%= render "agustos/shared/header" %>
      <main id="main" class="agustos-layout__main" tabindex="-1">
        <%= yield %>
      </main>
      <%= render "agustos/shared/footer" %>
    <% end %>
  </body>
</html>
