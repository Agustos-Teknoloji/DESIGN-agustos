---
import BrandLockup from './BrandLockup.astro';

interface Props {
  brandname: string;
  pathname?: string;
}
const { brandname, pathname = Astro.url.pathname } = Astro.props;
const items = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/blog', label: 'Writing' },
  { href: '/typography', label: 'Typography' },
];
const isCurrent = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
---
<header class="site-header">
  <div class="site-header__inner">
    <BrandLockup brandname={brandname} href="/" size={20} />
    <nav aria-label="Primary">
      {items.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
    padding: var(--space-lg) var(--measure-gutter);
  }
  .site-header__inner {
    max-width: var(--measure-content);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    flex-wrap: wrap;
  }
  nav {
    display: flex;
    gap: var(--space-lg);
    font-family: var(--display);
    font-size: var(--size-footnote);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }
  /* Nav links use the standard link treatment — bold + brand underline. */
  nav a { color: var(--ink-soft); }
  nav a:hover { color: var(--ink); }
  nav a[aria-current='page'] { color: var(--ink); }

  @media (max-width: 640px) {
    .site-header__inner { align-items: flex-start; }
    nav { width: 100%; gap: var(--space-md) var(--space-lg); flex-wrap: wrap; }
  }
</style>
