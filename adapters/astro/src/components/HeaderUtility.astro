---
import type { LanguageSwitch } from '../types/chrome';

interface Props {
  className?: string;
  languageSwitch?: LanguageSwitch | null;
  theme?: boolean;
  lang?: 'en' | 'tr';
}

// The names of the theme switch. The kit script agustos-chrome.js shows the one that applies.
const THEME_LABELS = {
  en: { themeToDark: 'Dark theme', themeToLight: 'Light theme' },
  tr: { themeToDark: 'Koyu tema', themeToLight: 'Açık tema' },
};

const { className, languageSwitch, theme = false, lang = 'en' } = Astro.props;
const labels = THEME_LABELS[lang === 'tr' ? 'tr' : 'en'];
---
<div class:list={['site-header__utility', className]}>
  {languageSwitch && (
    <a
      href={languageSwitch.href}
      class="site-header__lang-link"
      hreflang={languageSwitch.hreflang ?? languageSwitch.code}
      lang={languageSwitch.hreflang ?? languageSwitch.code}
      aria-label={languageSwitch.ariaLabel ?? languageSwitch.label}
      target={languageSwitch.external ? '_blank' : undefined}
      rel={languageSwitch.external ? 'noopener noreferrer' : undefined}
    >{languageSwitch.label}</a>
  )}

  {theme && (
    <button type="button" class="site-header__icon-btn agustos-theme-switch" data-agustos-theme>
      <span class="agustos-theme-switch__to-dark"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg><span class="agustos-theme-switch__label">{labels.themeToDark}</span></span>
      <span class="agustos-theme-switch__to-light"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4"/></svg><span class="agustos-theme-switch__label">{labels.themeToLight}</span></span>
    </button>
  )}
</div>

