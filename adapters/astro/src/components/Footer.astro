---
interface Props {
  brandname?: string;
}
const { brandname = 'Ağustos Teknoloji' } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <p class="type-footnote">{brandname} · &copy; {year}</p>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-6xl);
    border-top: 1px solid var(--rule);
    padding: var(--space-lg) var(--measure-gutter) var(--space-xl);
  }
  .site-footer p {
    max-width: var(--measure-content);
    margin: 0 auto;
  }
</style>
