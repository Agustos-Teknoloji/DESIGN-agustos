---
import type { LanguageSwitch } from '../types/chrome';

interface Props {
  className?: string;
  languageSwitch?: LanguageSwitch | null;
  theme?: boolean;
}

const { className, languageSwitch, theme = true } = Astro.props;
---
<div class:list={['site-header__utility', className]}>
  {languageSwitch && (
    <a
      href={languageSwitch.href}
      class="site-header__lang-link"
      aria-label={languageSwitch.ariaLabel ?? languageSwitch.label}
      target={languageSwitch.external ? '_blank' : undefined}
      rel={languageSwitch.external ? 'noopener noreferrer' : undefined}
    >{languageSwitch.code}</a>
  )}

  {theme && (
    <button type="button" class="site-header__icon-btn" aria-label="Toggle light/dark theme" data-theme-toggle>
      <svg class="site-header__theme-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"/>
        <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4"/>
      </svg>
      <svg class="site-header__theme-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
      </svg>
    </button>
  )}
</div>

<style>
  .site-header__utility { display: flex; align-items: center; gap: 0.125rem; }
  .site-header__utility--bar { display: none; margin-left: auto; }
  .site-header__utility--drawer { margin-left: 0; }

  .site-header__icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    color: var(--ink-soft);
    cursor: pointer;
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .site-header__icon-btn:hover { background: var(--rule); color: var(--ink); }
  .site-header__icon-btn:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  .site-header__theme-moon { display: none; }
  :global(html[data-theme="dark"]) .site-header__theme-sun { display: none; }
  :global(html[data-theme="dark"]) .site-header__theme-moon { display: inline-block; }

  .site-header__lang-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 0.25rem;
    color: var(--ink-faint);
    font-family: var(--display);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  .site-header__lang-link:hover { color: var(--ink); }
  .site-header__lang-link:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }

  @media (max-width: 1023px), (max-width: 1366px) and (hover: none) and (pointer: coarse) {
    .site-header__utility--bar { display: flex; justify-self: end; }
    .site-header__utility--drawer { display: none; }
  }

  @media (max-width: 480px) {
    .site-header__utility--bar { margin-left: 0; }
    .site-header__lang-link { padding-inline: 0.125rem; }
  }
</style>
