<?php
/**
 * Ağustos Design System v7 adapter bootstrap.
 * Merge this function into the consuming theme's functions.php.
 * A website gets no chrome class on the body element: the top menu and footer are the
 * default. Only product UI adds site-sidebar-layout. Brands never pick chrome.
 */
function agustos_design_system_assets(): void {
    wp_enqueue_style(
        'agustos-design-system',
        get_theme_file_uri('/assets/css/agustos.css'),
        array(),
        '7.10.0'
    );
    // The More menu closes on Escape, an outside click or focus leaving.
    wp_enqueue_script(
        'agustos-chrome',
        get_theme_file_uri('/assets/js/agustos-chrome.js'),
        array(),
        '7.10.0',
        array('strategy' => 'defer')
    );
}
add_action('wp_enqueue_scripts', 'agustos_design_system_assets');

/**
 * WordPress sets aria-current="page" on the current menu item. A parent of the
 * current page is its section: it gets aria-current="true", never "page", and
 * the kit draws the same red rule for both.
 */
function agustos_design_system_menu_section($atts, $item): array {
    $ancestor = array('current-menu-ancestor', 'current-menu-parent', 'current_page_ancestor', 'current_page_parent');
    if (empty($atts['aria-current']) && array_intersect($ancestor, (array) $item->classes)) {
        $atts['aria-current'] = 'true';
    }
    return $atts;
}
add_filter('nav_menu_link_attributes', 'agustos_design_system_menu_section', 10, 2);

function agustos_design_system_body_classes(array $classes): array {
    $classes[] = 'brand-agustos';
    $classes[] = 'paper-white';
    return $classes;
}
add_filter('body_class', 'agustos_design_system_body_classes');
