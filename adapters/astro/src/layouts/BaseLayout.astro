---
// Self-hosted fonts via @fontsource. Imported here so every page gets them.
// v3 stack: Inter Tight (display) + Inter (body) + JetBrains Mono (code).
// Variable axes (wght 100–900, italics) cover every weight in the system.
// Run `npm i @fontsource-variable/inter @fontsource-variable/inter-tight` if not yet installed.
import '@fontsource-variable/inter-tight/index.css';
import '@fontsource-variable/inter-tight/wght-italic.css';
import '@fontsource-variable/inter/index.css';
import '@fontsource-variable/inter/wght-italic.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';

import '../styles/tokens.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { FooterConfig, HeaderConfig } from '../types/chrome';

type Brand = 'agustos' | 'pataraz' | 'pld' | 'photo' | 'specquick';

interface Props {
  title: string;
  description?: string;
  /** Brand class — applied on <body> to scope --brand. */
  brand?: Brand;
  /** Substrate. 'cream' for branded contexts, 'white' for working/UI/email. */
  substrate?: 'cream' | 'white';
  /** Page language. Default 'en'. Use 'tr' for Turkish content (mandatory per §6). */
  lang?: string;
  /** Site chrome configuration. Defaults exercise the reusable DESIGN demo. */
  header?: HeaderConfig;
  footer?: FooterConfig;
  /** Include this page's <main> in the Pagefind index. */
  searchable?: boolean;
  /** Pagefind grouping used by the header search results. */
  searchKind?: 'page' | 'post';
  /**
   * Brand name shown in the header/footer wordmark. Always rendered lowercase
   * via CSS — pass any case here, the lockup normalizes it. Default per brand:
   *   ağustos · pataraz · pld türkiye · photometric · specquick
   */
  brandname?: string;
}

// Per-brand wordmark map. Page <title> can be different (Title Case for SEO/readability).
const BRAND_WORDMARKS: Record<Brand, string> = {
  agustos: 'ağustos',
  pataraz: 'pataraz',
  pld:     'pld türkiye',
  photo:   'photometric',
  specquick: 'specquick',
};

const {
  title,
  description = 'Published from Emre Güneş’s house — typography-first design.',
  brand = 'agustos',
  substrate = 'white',
  lang = 'en',
  brandname = BRAND_WORDMARKS[brand as Brand] ?? 'ağustos',
  header = {},
  footer = {},
  searchable = true,
  searchKind = 'page',
} = Astro.props;

const brandClass = `brand-${brand}`;
const substrateClass = substrate === 'white' ? 'paper-white' : '';
const bodyClass = [brandClass, substrateClass].filter(Boolean).join(' ');
const searchAttributes = searchable ? {
  'data-pagefind-body': '',
  'data-search-kind': searchKind,
  'data-search-lang': lang,
  'data-pagefind-filter': 'kind[data-search-kind], lang[data-search-lang]',
} : {};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.url.href} />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {/*
      FOUC-prevention: apply the saved theme before the page paints.
      Without this, a user with dark theme saved would see a brief flash of cream/light
      before the header script runs. Inline = synchronous, runs before <body>.
    */}
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('agustos:theme');
          if (theme === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
        } catch (e) { /* private mode / disabled storage — fall back to defaults */ }
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header brandname={brandname} pathname={Astro.url.pathname} lang={lang} config={header} />
    <main id="main" tabindex="-1" {...searchAttributes}>
      <slot />
    </main>
    <Footer brandname={brandname} config={footer} />
  </body>
</html>

<style is:global>
  body {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }
  body > main { flex: 1; }
</style>
