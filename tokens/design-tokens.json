{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Ağustos Design System",
  "version": "5.1.0",
  "description": "Canonical cross-medium design values. CSS, framework adapters, and Office templates are generated consumers.",
  "meta": {
    "referenceImplementation": "https://agustos.com",
    "authority": "DESIGN-agustos",
    "principle": "The website proves the grammar; this registry publishes it.",
    "locale": "tr"
  },
  "designDirection": {
    "name": "İskandivvian",
    "definition": "Scandinavian restraint filtered through Mediterranean warmth.",
    "naming": "Use this as a defined project label, not an established design movement.",
    "intent": "Create minimal, functional, and elegant experiences that feel calm, warm, and human.",
    "keywords": [
      "calm",
      "clear",
      "warm",
      "functional",
      "elegant",
      "approachable",
      "grounded",
      "quietly confident"
    ],
    "principles": [
      "Use white as the paper. Reserve cream for full-bleed callout and CTA bands. The six colours are white #ffffff, cream #fdf5f5, light gray #ebebeb, dark gray #404040, off-black #15130f, and red #cf142a.",
      "Express warmth through those grays, cream bands, comfortable spacing, readable typography, and approachable language.",
      "Make every section useful. Keep navigation, information, and next actions easy to understand.",
      "Use clear hierarchy and one alignment frame. Let spacing explain relationships without hiding useful content.",
      "Use modest corners and hairline rules. Do not use shadows, gradients, or textures.",
      "Keep text, controls, and technical tables on plain surfaces. Use authentic imagery only when it explains the work.",
      "Ration red to the 2px content-link rule, the 2px menu hover or current-page rule, and keyboard focus. The one fill exception is the dark-theme primary CTA. Dark theme reuses the same six roles, flipped. Retain registered logos, fonts, and accessible contrast.",
      "Write direct, helpful copy in sentence case. Do not use uppercase labels or eyebrow headings.",
      "Repeat the same primary CTA at most twice in the page body: the opening and one closing cream band. The header may carry it once.",
      "Ship marketing, catalog, and spec pages on white paper. Reserve dark theme for product UI.",
      "Introduce photographs in this order: product page, listing thumbnail, then homepage installation. Type-only pages stay complete.",
      "Use blockquote and pullquote on content pages only. Marketing pages use a compact trust line, not a testimonial."
    ],
    "avoid": [
      "Ornamental Mediterranean motifs or unrelated lifestyle imagery",
      "Red fills, red buttons, red statistics, or red as an element's own colour, except the dark-theme primary CTA",
      "Uppercase labels, eyebrow labels, arrows on buttons, or decorative motion",
      "Inflated luxury claims or forced friendliness",
      "A primary button in every section, card, or list",
      "A theme toggle on marketing chrome",
      "Lifestyle photography or a photograph behind body text",
      "Testimonial quotes on marketing pages"
    ],
    "acceptance": [
      "Pages feel warm, human, and complete through white paper, warm neutrals, clear typography, and helpful language.",
      "Visitors can understand the content and identify the next action quickly.",
      "The same primary CTA appears in the header, the opening, and at most one closing band.",
      "Marketing pages remain light without a theme control.",
      "Forms and technical content remain clear, readable, and easy to scan.",
      "Brand identity, keyboard focus, reduced motion, and supported themes remain intact."
    ]
  },
  "distribution": {
    "repository": "Agustos-Teknoloji/DESIGN-agustos",
    "cdnBase": "https://cdn.jsdelivr.net/gh/{repository}@v{version}/ui/",
    "rawBase": "https://raw.githubusercontent.com/{repository}/v{version}/ui/",
    "fonts": [
      {
        "file": "inter-tight-variable.woff2",
        "families": ["Inter Tight Variable", "Inter Tight"],
        "style": "normal",
        "weight": "100 900"
      },
      {
        "file": "inter-tight-variable-italic.woff2",
        "families": ["Inter Tight Variable", "Inter Tight"],
        "style": "italic",
        "weight": "100 900"
      },
      {
        "file": "inter-variable.woff2",
        "families": ["Inter Variable", "Inter"],
        "style": "normal",
        "weight": "100 900"
      },
      {
        "file": "inter-variable-italic.woff2",
        "families": ["Inter Variable", "Inter"],
        "style": "italic",
        "weight": "100 900"
      },
      {
        "file": "jetbrains-mono-variable.woff2",
        "families": ["JetBrains Mono Variable", "JetBrains Mono"],
        "style": "normal",
        "weight": "100 800"
      }
    ]
  },
  "foundations": {
    "color": {
      "$type": "color",
      "paperCream": { "$value": "#fdf5f5", "$description": "Full-bleed callout and CTA band. Logo red at 5% into white. Never the page paper." },
      "paperWhite": { "$value": "#ffffff", "$description": "Primary substrate. About 70% of every surface." },
      "paperGray": { "$value": "#ebebeb", "$description": "Functional surfaces: key-figure tiles, image regions, and summary panels." },
      "ink": { "$value": "#15130f", "$description": "Headlines, filled buttons, footer, and house-brand identity ink." },
      "inkSoft": { "$value": "#404040", "$description": "Secondary text." },
      "inkFaint": { "$value": "#8a8378", "$description": "Small labels and quiet metadata. Support value, not a seventh palette colour." },
      "ruleCream": { "$value": "#e8e4da", "$description": "Hairline rule on light surfaces. Support value, not a seventh palette colour." },
      "ruleWhite": { "$value": "#e8e4da", "$description": "Hairline rule alias kept for compatibility." },
      "paperDark": { "$value": "#15130f", "$description": "Dark paper. Reuses off-black. No new hex." },
      "inkDark": { "$value": "#ffffff", "$description": "Primary text on dark. Reuses white. No new hex." },
      "inkSoftDark": { "$value": "#8a8378", "$description": "Secondary text on dark. Reuses the faint-label support value." },
      "inkFaintDark": { "$value": "#8a8378", "$description": "Quiet text on dark. Same hex as inkSoftDark. No new hex." },
      "ruleDark": { "$value": "#404040", "$description": "Separator on dark. Reuses dark gray. No new hex." },
      "creamDark": { "$value": "#ebebeb", "$description": "Dark callout band. Reuses light gray. No new hex." },
      "surfaceDark": { "$value": "#404040", "$description": "Dark cards and panels. Reuses dark gray. No new hex." },
      "signalRed": { "$value": "#cf142a", "$description": "Shared Ağustos-family interaction signal for links, focus, markers, and small emphasis across every brand." },
      "stateSuccess": { "$value": "#1f6b4a", "$description": "Positive system feedback." },
      "stateWarning": { "$value": "#8a5a00", "$description": "Caution system feedback." },
      "stateDanger": { "$value": "#b42318", "$description": "Destructive or failed system feedback." },
      "stateInfo": { "$value": "#1a4d8f", "$description": "Informational system feedback." },
      "stateSuccessDark": { "$value": "#7ec9a2", "$description": "Positive system feedback on the dark substrate." },
      "stateWarningDark": { "$value": "#d9a441", "$description": "Caution system feedback on the dark substrate." },
      "stateDangerDark": { "$value": "#f08c82", "$description": "Destructive or failed system feedback on the dark substrate." },
      "stateInfoDark": { "$value": "#8ab6e8", "$description": "Informational system feedback on the dark substrate." }
    },
    "fontFamily": {
      "$type": "fontFamily",
      "display": { "$value": "Inter Tight", "$description": "Wordmarks, heroes, headings, labels, and designed UI." },
      "body": { "$value": "Inter", "$description": "Reading text and inline content." },
      "mono": { "$value": "JetBrains Mono", "$description": "Code, identifiers, units, and technical values." }
    },
    "fontWeight": {
      "$type": "fontWeight",
      "light": { "$value": 300 },
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "wordmark": { "$value": 650 },
      "bold": { "$value": 700 }
    },
    "fontSize": {
      "$type": "dimension",
      "hero": { "$value": "clamp(56px, 8.5vw, 104px)" },
      "heroMedium": { "$value": "clamp(40px, 5vw, 60px)" },
      "heroDeck": { "$value": "20px" },
      "h1": { "$value": "clamp(40px, 5vw, 60px)" },
      "h2": { "$value": "clamp(34px, 4.4vw, 52px)" },
      "h3": { "$value": "18px" },
      "h4": { "$value": "12.5px" },
      "body": { "$value": "16.5px" },
      "bodyCompact": { "$value": "15.5px" },
      "footnote": { "$value": "12.5px" }
    },
    "spacing": {
      "$type": "dimension",
      "2xs": { "$value": "4px" },
      "xs": { "$value": "8px" },
      "sm": { "$value": "12px" },
      "md": { "$value": "16px" },
      "lg": { "$value": "20px" },
      "xl": { "$value": "24px" },
      "2xl": { "$value": "32px" },
      "3xl": { "$value": "40px" },
      "4xl": { "$value": "48px" },
      "5xl": { "$value": "64px" },
      "6xl": { "$value": "80px" },
      "hero": { "$value": "112px" }
    },
    "radius": {
      "$type": "dimension",
      "small": { "$value": "4px" },
      "medium": { "$value": "6px" },
      "large": { "$value": "10px" }
    },
    "duration": {
      "$type": "duration",
      "micro": { "$value": "150ms" },
      "short": { "$value": "180ms" },
      "drawer": { "$value": "220ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "move": { "$value": [0.4, 0, 0.2, 1] }
    },
    "measure": {
      "$type": "dimension",
      "content": { "$value": "1180px", "$description": "Shared content column for page and chrome." },
      "gutter": { "$value": "32px", "$description": "Horizontal frame gutter." },
      "text": { "$value": "54ch", "$description": "Hero supporting copy measure." },
      "body": { "$value": "65ch", "$description": "Readable long-form measure. About 42rem in Inter at 16.5px, the content column agustos.com already uses." },
      "wide": { "$value": "1180px", "$description": "Media and data width. Same as the content column." },
      "controlMinimum": { "$value": "44px", "$description": "Minimum button-like target on the shorter axis." }
    },
    "border": {
      "$type": "dimension",
      "hairline": { "$value": "1px" },
      "signal": { "$value": "2px" }
    }
  },
  "semantic": {
    "color": {
      "$type": "color",
      "paper": { "$value": "{foundations.color.paperWhite}" },
      "surface": { "$value": "{foundations.color.paperGray}" },
      "cream": { "$value": "{foundations.color.paperCream}" },
      "text": { "$value": "{foundations.color.ink}" },
      "textMuted": { "$value": "{foundations.color.inkSoft}" },
      "textFaint": { "$value": "{foundations.color.inkFaint}" },
      "rule": { "$value": "{foundations.color.ruleCream}" },
      "brandMark": { "$value": "{brand.color}" },
      "signal": { "$value": "{foundations.color.signalRed}" },
      "focus": { "$value": "{semantic.color.signal}" }
    },
    "typography": {
      "display": { "$value": "{foundations.fontFamily.display}" },
      "body": { "$value": "{foundations.fontFamily.body}" },
      "data": { "$value": "{foundations.fontFamily.mono}" },
      "wordmarkWeight": { "$value": "{foundations.fontWeight.wordmark}" }
    },
    "layout": {
      "contentMeasure": { "$value": "{foundations.measure.content}" },
      "contentGutter": { "$value": "{foundations.measure.gutter}" },
      "readingMeasure": { "$value": "{foundations.measure.text}" },
      "bodyMeasure": { "$value": "{foundations.measure.body}" }
    },
    "shape": {
      "controlRadius": { "$value": "{foundations.radius.small}" },
      "buttonRadius": { "$value": "{foundations.radius.medium}" },
      "cardRadius": { "$value": "{foundations.radius.large}" }
    },
    "motion": {
      "interactionDuration": { "$value": "{foundations.duration.micro}" },
      "interactionEasing": { "$value": "{foundations.easing.standard}" }
    }
  },
  "themes": {
    "white": {
      "paper": { "$value": "{foundations.color.paperWhite}" },
      "surface": { "$value": "{foundations.color.paperWhite}" },
      "rule": { "$value": "{foundations.color.ruleWhite}" }
    },
    "dark": {
      "paper": { "$value": "{foundations.color.paperDark}" },
      "surface": { "$value": "{foundations.color.surfaceDark}" },
      "cream": { "$value": "{foundations.color.creamDark}" },
      "text": { "$value": "{foundations.color.inkDark}" },
      "textMuted": { "$value": "{foundations.color.inkSoftDark}" },
      "textFaint": { "$value": "{foundations.color.inkFaintDark}" },
      "rule": { "$value": "{foundations.color.ruleDark}" }
    }
  },
  "recipes": {
    "chrome": {
      "contentMeasure": { "$value": "{semantic.layout.contentMeasure}" },
      "gutter": { "$value": "{semantic.layout.contentGutter}" },
      "controlMinimum": { "$value": "{foundations.measure.controlMinimum}" },
      "paddingBlock": { "$value": "20px" },
      "gap": { "$value": "{foundations.spacing.2xl}" },
      "rule": { "$value": "{foundations.border.hairline}" }
    },
    "hero": {
      "paddingBlockStart": { "$value": "clamp(56px, 9vw, 112px)" },
      "paddingBlockEnd": { "$value": "clamp(48px, 6vw, 80px)" },
      "headline": { "$value": "heroMedium" },
      "deckMeasure": { "$value": "{semantic.layout.readingMeasure}" },
      "actionGap": { "$value": "{foundations.spacing.xl}" }
    },
    "section": {
      "paddingBlock": { "$value": "64px" },
      "headingGap": { "$value": "{foundations.spacing.sm}" },
      "rule": { "$value": "{foundations.border.hairline}" }
    },
    "card": {
      "surface": { "$value": "{semantic.color.surface}" },
      "padding": { "$value": "{foundations.spacing.xl}" },
      "gap": { "$value": "14px" },
      "gridGap": { "$value": "{foundations.spacing.lg}" },
      "radius": { "$value": "{semantic.shape.cardRadius}" },
      "border": { "$value": "{foundations.border.hairline}" },
      "markedBorder": { "$value": "{foundations.border.signal}" }
    },
    "dataTable": {
      "labelFamily": { "$value": "{semantic.typography.display}" },
      "valueFamily": { "$value": "{semantic.typography.data}" },
      "cellPaddingBlock": { "$value": "{foundations.spacing.xs}" },
      "cellPaddingInline": { "$value": "{foundations.spacing.sm}" },
      "rule": { "$value": "{foundations.border.hairline}" }
    },
    "document": {
      "page": { "$value": "A4" },
      "margin": { "$value": "22mm" },
      "topMargin": { "$value": "35mm" },
      "bodySize": { "$value": "11pt" },
      "titleSize": { "$value": "28pt" },
      "heading1Size": { "$value": "20pt" },
      "heading2Size": { "$value": "15pt" },
      "heading3Size": { "$value": "12pt" },
      "footnoteSize": { "$value": "8.5pt" },
      "bodyAfter": { "$value": "8pt" },
      "bodyLineSpacing": { "$value": 1.35 }
    },
    "presentation": {
      "width": { "$value": "13.333in" },
      "height": { "$value": "7.5in" },
      "margin": { "$value": "0.9in" },
      "titleSize": { "$value": "54pt" },
      "sectionTitleSize": { "$value": "44pt" },
      "slideTitleSize": { "$value": "36pt" },
      "bodySize": { "$value": "20pt" },
      "captionSize": { "$value": "12pt" }
    }
  },
  "compatibility": {
    "cssClasses": [
        "type-hero",
        "type-hero-md",
        "type-hero-deck",
        "type-h1",
        "type-h2",
        "type-h3",
        "type-h4",
        "type-body",
        "type-link",
        "type-code",
        "type-blockquote",
        "type-pullquote",
        "type-list-ol",
        "type-list-ul",
        "type-dl",
        "type-figure",
        "type-code-block",
        "type-table",
        "type-divider",
        "type-footnote",
        "site-frame",
        "container",
        "skip-link",
        "brand-agustos",
        "brand-pataraz",
        "brand-pld",
        "brand-iesdesk",
        "brand-specquick",
        "paper-white",
        "hero-links",
        "hero-link",
        "hero-link--primary",
        "hero-link--secondary",
        "hero-actions",
        "hero-action",
        "hero-action--primary",
        "hero-action--secondary",
        "hero-trust",
        "hero-visual",
        "agustos-section",
        "agustos-section__head",
        "agustos-card-grid",
        "agustos-card",
        "agustos-card--marked",
        "agustos-chrome-link",
        "agustos-fieldset",
        "agustos-field",
        "agustos-field--invalid",
        "agustos-label",
        "agustos-label--required",
        "agustos-input",
        "agustos-textarea",
        "agustos-select",
        "agustos-check",
        "agustos-hint",
        "agustos-error",
        "agustos-button",
        "agustos-button--primary",
        "agustos-button--secondary",
        "agustos-button--quiet",
        "agustos-badge",
        "agustos-badge--success",
        "agustos-badge--warning",
        "agustos-badge--danger",
        "agustos-badge--info",
        "agustos-badge--signal",
        "agustos-notice",
        "agustos-notice__title",
        "agustos-notice--success",
        "agustos-notice--warning",
        "agustos-notice--danger",
        "agustos-notice--info",
        "agustos-tabs",
        "agustos-tab",
        "agustos-tabs__panel"
      ]
  }
}
