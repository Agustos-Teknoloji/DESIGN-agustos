---
import type { SearchLabels } from '../types/chrome';

interface Props {
  variant: 'desktop-dropdown' | 'responsive-row';
  labels: SearchLabels;
  panelId: string;
  resultsId: string;
}

const { variant, labels, panelId, resultsId } = Astro.props;
const responsive = variant === 'responsive-row';
---
{responsive ? (
  <div class="site-header__search-row">
    <div class="site-header__search-shell site-frame">
      <div class="site-header__search site-header__search--responsive" data-search-root data-search-variant="responsive" data-search-labels={JSON.stringify(labels)}>
        <label class="site-header__search-field">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input type="search" placeholder={labels.placeholder} aria-label={labels.aria} aria-controls={panelId} aria-expanded="false" autocomplete="off" data-search-input />
        </label>
        <div id={panelId} class="site-header__search-panel" data-search-panel hidden>
          <div class="site-header__search-output">
            <p class="site-header__search-status" data-search-status role="status" aria-live="polite"></p>
            <div id={resultsId} class="site-header__search-results" data-search-results></div>
          </div>
        </div>
      </div>
    </div>
  </div>
) : (
  <div class="site-header__search site-header__search--desktop" data-search-root data-search-variant="desktop" data-search-labels={JSON.stringify(labels)}>
    <button type="button" class="site-header__search-toggle" aria-label={labels.aria} aria-expanded="false" aria-controls={panelId} data-search-toggle>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    </button>
    <div id={panelId} class="site-header__search-panel" data-search-panel hidden>
      <label class="site-header__search-field">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input type="search" placeholder={labels.placeholder} aria-label={labels.aria} aria-controls={resultsId} autocomplete="off" data-search-input />
      </label>
      <div class="site-header__search-output">
        <p class="site-header__search-status" data-search-status role="status" aria-live="polite"></p>
        <div id={resultsId} class="site-header__search-results" data-search-results></div>
      </div>
    </div>
  </div>
)}

