{
  "name": "agustos-astro",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Astro reference adapter for the Ağustos Design System v3.0.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist && npm run test:pagefind",
    "preview": "astro preview",
    "check": "astro check",
    "test": "npm run test:chrome",
    "test:chrome": "node --test tests/chrome.test.mjs",
    "test:pagefind": "node --test tests/pagefind.test.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^4.0.3",
    "@astrojs/sitemap": "^3.2.1",
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/inter-tight": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.1",
    "astro": "^5.1.1",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "pagefind": "^1.5.2"
  }
}
