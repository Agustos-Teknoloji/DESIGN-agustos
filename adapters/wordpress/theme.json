        "rem",
        "em",
        "%",
        "vh",
        "vw"
      ]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Inter Tight",
          "fontFamily": "'Inter Tight', 'Inter', sans-serif"
        },
        {
          "slug": "body",
          "name": "Inter",
          "fontFamily": "'Inter', sans-serif"
        },
        {
          "slug": "mono",
          "name": "JetBrains Mono",
          "fontFamily": "'JetBrains Mono', monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "footnote",
          "name": "Footnote",
          "size": "13px"
        },
        {
          "slug": "body-compact",
          "name": "Body Compact",
          "size": "15.5px"
        },
        {
          "slug": "body",
          "name": "Body",
          "size": "16.5px"
        },
        {
          "slug": "heading-3",
          "name": "Heading 3",
          "size": "21px"
        },
        {
          "slug": "heading-2",
          "name": "Heading 2",
          "size": "clamp(34px, 3.4vw, 43px)"
        },
        {
          "slug": "heading-1",
          "name": "Heading 1",
          "size": "clamp(43px, 4.6vw, 55px)"
        },
        {
          "slug": "hero-medium",
          "name": "Hero Medium",
          "size": "clamp(43px, 4.6vw, 55px)"
        },
        {
          "slug": "hero",
          "name": "Hero",
          "size": "clamp(55px, 7vw, 89px)"
        }
      ]
    },
    "custom": {
      "agustos": {
        "radius": {
          "medium": "6px",
          "large": "12px"
        },
        "motion": {
          "duration": "150ms",
          "easing": "cubic-bezier(0.2, 0, 0, 1)"
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|paper-white",
      "text": "var:preset|color|ink"
    },
    "spacing": {
      "padding": {
        "left": "var:preset|spacing|xl",
        "right": "var:preset|spacing|xl"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "lineHeight": "1.65"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|display",
          "fontWeight": "500"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|ink"
        },
        "typography": {
          "fontWeight": "600",
          "textDecoration": "underline"
        }
      }
    }
  }
}
