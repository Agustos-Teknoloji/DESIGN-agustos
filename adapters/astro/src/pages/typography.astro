---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandLockup from '../components/BrandLockup.astro';

// Brand-switcher demo data
const brands = [
  { id: 'agustos',   name: 'Ağustos' },
  { id: 'pataraz',   name: 'Pataraz' },
  { id: 'pld',       name: 'PLD Türkiye' },
  { id: 'iesdesk',   name: 'IESDesk' },
  { id: 'specquick', name: 'SpecQuick' },
] as const;

// Per-brand wordmark mapping (matches BaseLayout's BRAND_WORDMARKS).
const portfolio = [
  { brand: 'agustos',   wordmark: 'ağustos' },
  { brand: 'pataraz',   wordmark: 'pataraz' },
  { brand: 'pld',       wordmark: 'pld türkiye' },
  { brand: 'iesdesk',   wordmark: 'iesdesk' },
  { brand: 'specquick', wordmark: 'specquick' },
] as const;
---
<BaseLayout
  title="Typography showcase — Ağustos Design System v5.0.1"
  description="Every published type token, exercised on one page."
>
  <article class="container">
    <p class="type-h4">Handbook inspect</p>
    <p class="type-body">This page is a type showcase, not marketing chrome. The control inspects product-UI dark. Marketing pages do not ship a theme toggle.</p>
    <p>
      <button class="agustos-button agustos-button--secondary" type="button" id="theme-inspect">Dark theme</button>
    </p>

    {/* ---- Hero showcase ---- */}
    <section style="margin-bottom: 4rem;">
      <p class="type-h4" style="margin-bottom: 1.5rem;">v5 · Hero · type-hero</p>
      <h1 class="type-hero">Where light meets architecture.</h1>
      <p class="type-hero-deck">A studio working with Turkey's leading designers since 2009. Twelve international brands, one specification discipline.</p>
    </section>

    <section style="margin-bottom: 4rem;">
      <p class="type-h4" style="margin-bottom: 1.5rem;">Hero (medium) · type-hero-md</p>
      <h2 class="type-hero-md">Premium luminaires, mid-tier pricing.</h2>
      <p class="type-hero-deck">Pataraz delivers project-grade fixtures without the project-grade markup.</p>
    </section>

    <hr class="type-divider" />

    <h1 class="type-h1">The 24 tokens</h1>
    <p class="type-body"><em>One page. One of every type token. The same registry translates into web, PowerPoint, Word, and Google-compatible imports. Inter Tight (display) + Inter (body) + JetBrains Mono.</em></p>

    {/* ---- Brand switcher ---- */}
    <h4 class="type-h4">Brand</h4>
    <div class="switcher" role="tablist" aria-label="Brand">
      {brands.map((b) => (
        <button data-brand={b.id} type="button" class={`switcher__btn brand-${b.id}`}>
          <span class="switcher__swatch"></span>
          <span>{b.name}</span>
        </button>
      ))}
    </div>

    <hr class="type-divider" />

    {/* ---- Brand portfolio: all four lockups in Inter Tight 650 ---- */}
    <h4 class="type-h4">Brand portfolio</h4>
    <p class="type-body">
      Five wordmarks in Inter Tight 650. Ağustos alone is red; the other house brands are off-black `#15130f`. Same lockup grammar
      across the portfolio: symbol height = 1.4× wordmark cap height, gap = 0.4× wordmark size,
      always lowercase. The Turkish <em>ı</em> in <em>pataraz</em> and <em>pld türkiye</em> and
      the <em>ğ</em> in <em>ağustos</em> show how Inter Tight handles the Turkish alphabet at every size.
    </p>

    <div class="portfolio">
      {portfolio.map((p) => (
        <div class={`portfolio__item brand-${p.brand}`}>
          <div class="portfolio__swatch"></div>
          <div class="portfolio__lockups">
            <div class="portfolio__lockup portfolio__lockup--lg">
              <BrandLockup brandname={p.wordmark} size={36} />
            </div>
            <div class="portfolio__lockup portfolio__lockup--md">
              <BrandLockup brandname={p.wordmark} size={22} />
            </div>
            <div class="portfolio__lockup portfolio__lockup--sm">
              <BrandLockup brandname={p.wordmark} size={14} />
            </div>
          </div>
        </div>
      ))}
    </div>

    {/* ---- Negative expression ---- */}
    <h4 class="type-h4">Negative expression</h4>
    <p class="type-body">
      White symbol and wordmark on the registered identity tile (DESIGN.md §"Three expressions"). For favicons,
      monograms, identity tiles, and hero stamps. The reverse marks use footer ink
      so the tile reads correctly in both light and dark themes.
    </p>

    <div class="portfolio-negative">
      {portfolio.map((p) => (
        <div class={`portfolio-negative__tile brand-${p.brand}`}>
          <BrandLockup brandname={p.wordmark} size={28} />
        </div>
      ))}
    </div>

    <hr class="type-divider" />

    {/* ---- Headings (4) ---- */}
    <h4 class="type-h4">Headings (4)</h4>
    <h1 class="type-h1">H1 — The biggest thing on the page</h1>
    <h2 class="type-h2">H2 — Section break</h2>
    <h3 class="type-h3">H3 — Subsection in italic, by token rule</h3>
    <h4 class="type-h4">H4 — label / meta</h4>

    <hr class="type-divider" />

    {/* ---- Body & inline (8) ---- */}
    <h4 class="type-h4">Body &amp; inline (8)</h4>

    <p class="type-body">
      The <em>body token</em> is Inter at 16.5 / 1.65 — the most rigorously screen-engineered open-source sans.
      Inline <strong>strong</strong> is 700, inline <em>em</em> is italic, and a <a href="#">link</a> renders bold with a 2px shared-red underline at 3px offset — one family signal across every brand.
      Code uses <code>font-family: var(--mono)</code> at 0.86em with a soft tint background.
      Chemistry survives: H<sub>2</sub>O, CO<sub>2</sub>. Units survive: 240&nbsp;m<sup>2</sup>, 2<sup>16</sup>.
      Revisions render with <s>strikethrough</s> in <code>--ink-faint</code>.
    </p>

    <hr class="type-divider" />

    {/* ---- Block-level (9) ---- */}
    <h4 class="type-h4">Block-level (9) — blockquote</h4>
    <blockquote class="type-blockquote">
      Portability over preference. Every design decision must survive translation across markdown → web → PDF → docx → plain text.
      <cite>Ağustos Design System v5.0.1 · Rule 1</cite>
    </blockquote>

    <h4 class="type-h4">Pullquote</h4>
    <p class="type-pullquote">The publisher precedes the brand. The shared symbol and neutral identity system identify the house; the wordmark names the publication.</p>

    <h4 class="type-h4">Ordered list</h4>
    <ol>
      <li>Pick a name (lowercase wordmark, 1–3 words, balanced next to the symbol).</li>
      <li>Use neutral black and white identity ink unless the brand is Ağustos.</li>
      <li>Apply existing lockup grammar — Inter Tight 650, neutral tracking.</li>
    </ol>

    <h4 class="type-h4">Unordered list</h4>
    <ul>
      <li>Inter Tight — display family for logo, hero, headings, UI labels.</li>
      <li>Inter — body family for paragraphs, lists, blockquote, footnotes.</li>
      <li>JetBrains Mono — code legibility, ligatures, tabular figures.</li>
    </ul>

    <h4 class="type-h4">Definition list</h4>
    <dl>
      <dt>Substrate</dt>
      <dd>White <code>--paper</code>. Cream <code>--cream</code> for callout bands only.</dd>
      <dt>Rule</dt>
      <dd>Hairline separator. <code>--rule</code> on light surfaces.</dd>
      <dt>Locale</dt>
      <dd>Turkish content declares <code>lang="tr"</code> and the global <code>font-feature-settings: "locl"</code> handles correct capitalization (i → İ).</dd>
    </dl>

    <h4 class="type-h4">Figure</h4>
    <figure class="type-figure">
      <div style="background: var(--surface); aspect-ratio: 16 / 9; display: grid; place-items: center; color: var(--ink-faint); font-family: var(--display); font-size: 12.5px; font-weight: 600;">
        Image placeholder
      </div>
      <figcaption>Figure 1 — A reference render slot, sized for editorial use. Caption is 13.5px italic in <code>--ink-faint</code>.</figcaption>
    </figure>

    <h4 class="type-h4">Code block</h4>
    <pre><code>{`body.brand-agustos.paper-white {
  /* --brand, --paper, and --ink resolve from the kit. Do not retype a hex. */
}`}</code></pre>

    <h4 class="type-h4">Table</h4>
    <table class="type-table">
      <thead>
        <tr>
          <th>Brand</th>
          <th>Colour</th>
          <th>Token</th>
          <th>Refined</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>Ağustos</td><td>Red</td><td><code>--brand-agustos</code></td><td>—</td></tr>
        <tr><td>Pataraz</td><td>Off-black</td><td><code>--brand-pataraz</code></td><td>house neutral</td></tr>
        <tr><td>PLD Türkiye</td><td>Off-black</td><td><code>--brand-pld</code></td><td>—</td></tr>
        <tr><td>IESDesk</td><td>Off-black</td><td><code>--brand-iesdesk</code></td><td>house neutral</td></tr>
        <tr><td>SpecQuick</td><td>Off-black</td><td><code>--brand-specquick</code></td><td>house neutral</td></tr>
      </tbody>
    </table>

    <hr class="type-divider" />

    {/* ---- Supporting (1) ---- */}
    <h4 class="type-h4">Supporting (1) — footnote</h4>
    <p class="type-footnote">
      <sup>1</sup> Footnotes use the footnote token: 12.5px body (Inter) in <code>--ink-faint</code>, with the <code>sup</code> reference marker carrying shared signal red at weight 600.
    </p>

    <hr class="type-divider" />

    {/* ---- Turkish locale demo ---- */}
    <h4 class="type-h4">Turkish locale (lang="tr")</h4>
    <p class="type-body" lang="tr">
      Işığın mimariyle buluştuğu yer. <strong>Türkçe içerik</strong> her zaman <code>lang="tr"</code> taşır;
      bu, <em>locl</em> OpenType özelliklerinin doğru çalışması için zorunludur.
    </p>
    <p class="type-h4" lang="tr">başlık denemesi — i → İ</p>
  </article>
</BaseLayout>

<script define:vars={{ brandIds: brands.map((b) => b.id) }}>
  // Brand switcher — toggles the body class.
  const buttons = document.querySelectorAll('.switcher__btn');
  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const brand = btn.dataset.brand;
      if (!brand) return;
      const body = document.body;
      brandIds.forEach((id) => body.classList.remove(`brand-${id}`));
      body.classList.add(`brand-${brand}`);
    });
  });

  document.getElementById('theme-inspect')?.addEventListener('click', () => {
    const root = document.documentElement;
    root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
  });
</script>

<style>
  .switcher { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
  .switcher__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    font-family: var(--display);
    font-size: 12px;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
    transition: border-color 120ms ease;
  }
  .switcher__btn:hover { border-color: var(--ink-soft); }
  .switcher__swatch {
    width: 12px; height: 12px;
    border-radius: var(--radius-sm);
    background: var(--brand);
  }

  /* ---- Brand portfolio ---- */
  .portfolio {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    margin: 1.5rem 0 2rem;
    border-top: 1px solid var(--rule);
  }
  .portfolio__item {
    display: grid;
    grid-template-columns: 8px 1fr;
    gap: 1.5rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--rule);
    align-items: center;
  }
  .portfolio__swatch {
    align-self: stretch;
    border-radius: var(--radius-sm);
    background: var(--brand);
  }
  .portfolio__lockups {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .portfolio__lockup {
    display: flex;
    align-items: baseline;
  }
  /* Reduce the visual repetition: small + medium share a row on wider screens */
  @media (min-width: 720px) {
    .portfolio__lockups {
      display: grid;
      grid-template-columns: 1fr auto auto;
      align-items: center;
      gap: 2rem;
    }
    .portfolio__lockup--lg { grid-column: 1; }
    .portfolio__lockup--md { grid-column: 2; }
    .portfolio__lockup--sm { grid-column: 3; }
  }

  /* ---- Negative expression: registered identity tiles with cream/white lockup ---- */
  .portfolio-negative {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 1.5rem 0 2rem;
  }
  @media (min-width: 720px) {
    .portfolio-negative {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .portfolio-negative__tile {
    /* Identity tile. Footer ink stays white across themes, so the negative
       lockup keeps contrast when the handbook inspects dark product UI. */
    --lockup-color: var(--footer-ink);
    background: var(--brand);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 96px;
  }
</style>
