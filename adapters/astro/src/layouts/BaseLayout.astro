---
// Self-hosted fonts via @fontsource. Imported here so every page gets them.
// v2.x stack: Inter Tight (display) + Inter (body) + JetBrains Mono (code).
// Variable axes (wght 100–900, italics) cover every weight in the system.
// Run `npm i @fontsource-variable/inter @fontsource-variable/inter-tight` if not yet installed.
import '@fontsource-variable/inter-tight/index.css';
import '@fontsource-variable/inter-tight/wght-italic.css';
import '@fontsource-variable/inter/index.css';
import '@fontsource-variable/inter/wght-italic.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';

import '../styles/tokens.css';
import Sidebar from '../components/Sidebar.astro';
import MobileHeader from '../components/MobileHeader.astro';
import Footer from '../components/Footer.astro';

type Brand = 'agustos' | 'pataraz' | 'pld' | 'photo';

interface Props {
  title: string;
  description?: string;
  /** Brand class — applied on <body> to scope --brand. */
  brand?: Brand;
  /** Substrate. 'cream' for branded contexts, 'white' for working/UI/email. */
  substrate?: 'cream' | 'white';
  /** Page language. Default 'en'. Use 'tr' for Turkish content (mandatory per §6). */
  lang?: string;
  /**
   * Brand name shown in the header/footer wordmark. Always rendered lowercase
   * via CSS — pass any case here, the lockup normalizes it. Default per brand:
   *   ağustos · pataraz · pld türkiye · photometric batch
   */
  brandname?: string;
}

// Per-brand wordmark map. Page <title> can be different (Title Case for SEO/readability).
const BRAND_WORDMARKS: Record<Brand, string> = {
  agustos: 'ağustos',
  pataraz: 'pataraz',
  pld:     'pld türkiye',
  photo:   'photometric',
};

const {
  title,
  description = 'Published from Emre Güneş’s house — typography-first design.',
  brand = 'agustos',
  substrate = 'cream',
  lang = 'en',
  brandname = BRAND_WORDMARKS[brand as Brand] ?? 'ağustos',
} = Astro.props;

const brandClass = `brand-${brand}`;
const substrateClass = substrate === 'white' ? 'paper-white' : '';
const bodyClass = [brandClass, substrateClass].filter(Boolean).join(' ');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.url.href} />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {/*
      FOUC-prevention: apply saved theme + lang from localStorage BEFORE the page paints.
      Without this, a user with dark theme saved would see a brief flash of cream/light
      before the Sidebar's script runs. Inline = synchronous, runs before <body>.
    */}
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('agustos:theme');
          if (theme === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
          var lang = localStorage.getItem('agustos:lang');
          if (lang === 'en' || lang === 'tr') document.documentElement.setAttribute('lang', lang);
        } catch (e) { /* private mode / disabled storage — fall back to defaults */ }
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <MobileHeader brandname={brandname} />
    <Sidebar brandname={brandname} pathname={Astro.url.pathname} />
    <div class="layout-with-sidebar">
      <main id="main">
        <slot />
      </main>
      <Footer brandname={brandname} />
    </div>
  </body>
</html>

<style is:global>
  /* Offset content so it sits to the right of the fixed sidebar (≥1024px).
     On smaller screens the sidebar is a drawer overlaying the content, so no
     offset — main + footer flow full-width below the mobile header. */
  .layout-with-sidebar {
    margin-left: 280px;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }
  .layout-with-sidebar > main { flex: 1; }

  @media (max-width: 1023px) {
    .layout-with-sidebar { margin-left: 0; }
  }
</style>
