---
import BrandLockup from './BrandLockup.astro';
import type { FooterConfig } from '../types/chrome';

interface Props {
  brandname?: string;
  config?: FooterConfig;
}

const { brandname = 'ağustos', config = {} } = Astro.props;
const year = new Date().getFullYear();
const description = config.description ?? 'Ağustos Design System · multi-brand typography and chrome';
const cta = config.cta === undefined
  ? { href: '/about', label: 'Contact' }
  : config.cta;
const columns = config.columns ?? [
  {
    heading: 'Explore',
    links: [
      { href: '/', label: 'Home' },
      { href: '/about', label: 'About' },
    ],
  },
  {
    heading: 'Content',
    links: [
      { href: '/blog', label: 'Writing' },
      { href: '/typography', label: 'Typography' },
    ],
  },
  {
    heading: 'Repository',
    links: [
      { href: 'https://github.com/Agustos-Teknoloji/DESIGN-agustos', label: 'Source', external: true },
      { href: 'https://github.com/Agustos-Teknoloji/DESIGN-agustos/blob/main/DESIGN.md', label: 'Design spec', external: true },
      { href: 'https://github.com/Agustos-Teknoloji/DESIGN-agustos/blob/main/ASSETS.md', label: 'Asset index', external: true },
    ],
  },
];
---
<footer class="site-footer">
  <div class="site-footer__inner site-frame">
    <div class="site-footer__brand">
      <BrandLockup brandname={brandname} expression="mono" size={20} />
      <p class="type-footnote">{description} · &copy; {year}</p>
    </div>

    <div class="site-footer__cols">
      {columns.map((column) => (
        <nav class="site-footer__col" aria-label={column.ariaLabel ?? column.heading}>
          <p class="type-h4 site-footer__col-heading">{column.heading}</p>
          <ul class="site-footer__list">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="site-footer__link"
                  aria-label={link.ariaLabel}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                >{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
      {cta && (
        <a
          href={cta.href}
          class="agustos-button agustos-button--primary site-footer__cta"
          aria-label={cta.ariaLabel}
          target={cta.external ? '_blank' : undefined}
          rel={cta.external ? 'noopener noreferrer' : undefined}
        >{cta.label}</a>
      )}
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    background: var(--footer-paper);
    color: var(--footer-ink);
    border-top: 0;
    --lockup-color: var(--footer-ink);
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 48px;
    padding-block: 56px;
  }
  .site-footer__brand { display: flex; flex-direction: column; gap: 14px; flex: 1 1 220px; max-width: 40ch; }
  .site-footer__brand .type-footnote,
  .site-footer .type-h4,
  .site-footer__link { color: var(--footer-ink); }
  .site-footer__brand .type-footnote { margin: 0; }
  .site-footer__cta { align-self: flex-start; }
  .site-footer .agustos-button--primary {
    background: var(--footer-ink);
    color: var(--footer-paper);
    border-color: var(--footer-ink);
  }
  .site-footer .agustos-button--primary:hover {
    background: var(--footer-cta-hover);
    border-color: var(--footer-cta-hover);
    color: var(--footer-paper);
  }
  .site-footer__cols { display: flex; flex-wrap: wrap; flex: 1 1 360px; gap: 32px; margin-left: auto; }
  .site-footer__col { flex: 1 1 140px; }
  .site-footer__col-heading { margin: 0 0 12px; }
  .site-footer__list { display: flex; flex-direction: column; gap: 9px; margin: 0; padding: 0; list-style: none; }
  .site-footer__link { font-family: var(--display); font-size: 15px; font-weight: 500; text-decoration: none; }
  .site-footer__link:focus-visible { outline: 2px solid var(--signal); outline-offset: 2px; }
</style>
