---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    kind: 'Cultural',
    title: 'A museum, relit',
    body: 'Gallery-grade tunable white and a concealed track system for a restored Ottoman hall.',
  },
  {
    kind: 'Retail',
    title: 'Flagship, Nişantaşı',
    body: 'Accent and ambient layers tuned to the merchandise, commissioned on site.',
  },
  {
    kind: 'Workplace',
    title: 'HQ, Maslak',
    body: 'Low-glare UGR<19 office field with daylight-linked dimming throughout.',
  },
];
---
<BaseLayout
  screen="home"
  title="Ağustos Teknoloji — lighting agency and distribution"
  description="Ağustos Teknoloji designs, specifies, and distributes architectural lighting — from the photometric study to the fixture on site."
  header={{
    // Six items: the menu shows the first four and puts the rest under "More".
    nav: [
      { href: '/', label: 'Home' },
      { href: '#work', label: 'Work' },
      { href: '/about', label: 'Studio' },
      { href: '/blog', label: 'Writing' },
      { href: '/typography', label: 'Typography' },
      { href: '#catalogue', label: 'Catalogue' },
    ],
    cta: { href: '/about', label: 'Contact' },
    languageSwitch: { href: '/about', label: 'Türkçe', code: 'TR', ariaLabel: 'Türkçe', hreflang: 'tr' },
  }}
  footer={{
    note: 'Ağustos Teknoloji · architectural lighting, agency & distribution · İstanbul, Türkiye.',
    links: [
      { href: 'https://www.linkedin.com/company/agustostek/', label: 'LinkedIn', external: true },
      { href: 'https://github.com/Agustos-Teknoloji/DESIGN-agustos/blob/main/DESIGN.md', label: 'Design spec', external: true },
      { href: '/about', label: 'Privacy' },
      { href: '/about', label: 'Türkçe', hreflang: 'tr' },
    ],
  }}
>
  <section class="container" aria-labelledby="hero-title">
    <h1 id="hero-title" class="type-hero">Light, <mark class="type-highlight">placed with intent</mark>.</h1>
    <p class="type-hero-deck">Ağustos Teknoloji designs, specifies, and distributes architectural lighting — from the photometric study to the fixture on site.</p>
    <div class="hero-actions">
      <a class="agustos-button agustos-button--primary" href="#work">See selected work</a>
      <a class="agustos-button agustos-button--secondary" href="/about">Talk to the studio</a>
    </div>
    <p class="hero-trust">2009–2026 · 240+ projects across Türkiye · partner to leading European luminaire makers</p>
  </section>

  <section class="site-frame agustos-section" id="work" aria-labelledby="work-title">
    <div class="agustos-section__head">
      <h2 id="work-title" class="type-h2">Selected work</h2>
      <a class="type-link" href="#work">All projects</a>
    </div>
    <div class="grid-3">
      {projects.map((project, index) => (
        <article class:list={['agustos-card', { 'agustos-card--marked': index === 0 }]}>
          <p class="type-h4">{project.kind}</p>
          <h3 class="type-h3">{project.title}</h3>
          <p class="type-body">{project.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="band band--cream" id="catalogue" aria-labelledby="band-title">
    <div class="site-frame">
      <h2 id="band-title" class="type-h2">Every project ships documented.</h2>
      <p class="type-body prose">Every project ships with its photometric study, IES files, and a commissioning report. The work is documented as carefully as it is designed.</p>
      <div class="hero-actions">
        <a class="agustos-button agustos-button--primary" href="/about">Request pricing</a>
        <a class="agustos-button agustos-button--quiet" href="/about">Download a sample dossier</a>
      </div>
    </div>
  </section>
</BaseLayout>
